<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FAQ — design_meril_beri</title>
<meta name="description" content="Часті питання: правки, пакет правок, оплата та умови роботи.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:wght@200;300;400&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16181A; --muted:#63645C; --accent:#FF4B1F;
    --red:#e8322e; --font:"Noto Sans",sans-serif; --mono:"JetBrains Mono",ui-monospace,monospace;
  }
  *,*::before,*::after{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{ margin:0; background:transparent; color:var(--ink); font-family:var(--font); }
  h1,h2,h3{ margin:0; line-height:1.15; font-weight:600; }
  p{ margin:0; } a{ color:inherit; } ul{ margin:0; padding:0; list-style:none; }
  button{ font-family:inherit; cursor:pointer; }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }

  /* ---------- header + меню (як на головній) ---------- */
  header{ position:sticky; top:0; z-index:100; background:rgba(255,255,255,.5); backdrop-filter:blur(5px); }
  .nav{ display:flex; align-items:center; justify-content:space-between; padding:16px 50px; }
  .logo-img{ height:90px; width:auto; display:block; }
  .nav-links{
    position:absolute; top:100%; right:0; width:min(320px,100vw);
    height:calc(100vh - 122px); height:calc(100dvh - 122px);
    display:flex; flex-direction:column; gap:clamp(36px,7vh,80px);
    padding:40px 32px 40px 36px; overflow-y:auto;
    background:rgba(255,255,255,.55); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
    transform:translateX(100%); visibility:hidden;
    transition:transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s linear .35s;
  }
  .nav-links.is-open{ transform:translateX(0); visibility:visible; transition:transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s; }
  .nav-links a{ display:flex; align-items:flex-end; gap:6px; text-decoration:none; }
  .nav-folder{ display:block; width:84px; height:auto; flex:none; transition:transform .3s cubic-bezier(.2,.8,.2,1); }
  .nav-folder--faq{ width:100px; margin-top:-20px; }
  .nav-label{ margin-bottom:14px; padding:6px 10px; background:#fff; color:#111; font-size:16px; font-weight:400; line-height:1.2; transition:color .15s ease; }
  .nav-links a:hover .nav-folder{ transform:translateY(-4px) rotate(-3deg); }
  .nav-links a:hover .nav-label{ color:var(--accent); }
  .nav-toggle{ background:none; border:none; padding:4px 0; transition:transform .25s cubic-bezier(.2,.8,.2,1); }
  .nav-toggle:hover{ transform:translateY(-2px) rotate(-2deg); }
  .nav-toggle img{ display:block; height:44px; width:auto; }
  @media (max-width:760px){ .nav{ padding:16px 20px; } .nav-links{ gap:36px; padding-top:28px; } }

  /* ---------- фото-банер ---------- */
  .faq-photo{
    position:relative; width:100%; aspect-ratio:1000/300; max-height:420px; overflow:hidden;
    display:grid; place-items:center;
    background:conic-gradient(rgba(255,255,255,.95) 25%, rgba(239,239,239,.95) 0 50%, rgba(255,255,255,.95) 0 75%, rgba(239,239,239,.95) 0) 0 0 / clamp(18px,2.3vw,44px) clamp(18px,2.3vw,44px);
  }
  .faq-photo span{ font-family:var(--mono); font-weight:300; font-size:1.2rem; }
  .faq-photo img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  /* ---------- питання ---------- */
  .faq-bg{ background:#f4f4f0; } /* світло-сірий фон, щоб білий папір було видно, як на макеті */
  .faq{ max-width:1000px; margin:0 auto; padding:clamp(40px,7vw,90px) 20px 80px; }
  .faq-item + .faq-item{ margin-top:clamp(56px,8vw,110px); }
  .faq-q{
    font-family:var(--mono); font-weight:300; letter-spacing:.06em;
    font-size:clamp(1.05rem,2vw,1.55rem);
    text-align:center; margin-bottom:clamp(20px,3vw,36px);
  }
  .faq-q .ico{ display:inline-block; margin-left:.3em; color:#3d7f86; }

  /* папір під текстом */
  .paper{
    background:
      url("data:image/webp;base64,") center / 100% 100% no-repeat;
    padding:clamp(28px,5.5%,56px) clamp(46px,12%,120px);
    font-family:var(--mono); font-weight:300; color:#2a2a28;
    font-size:clamp(.72rem,1.12vw,.98rem); line-height:1.5;
    filter:drop-shadow(0 10px 18px rgba(40,30,30,.12));
  }
  .paper p + p, .paper ul{ margin-top:.5em; }
  .paper .lead{ font-size:1.12em; font-weight:400; display:flex; gap:.7em; align-items:flex-start; }
  .paper .lead .ico{ color:var(--red); flex:none; }
  .paper ul li{ padding-left:1em; text-indent:-1em; }
  .paper ul li::before{ content:"•"; padding-right:.35em; }
  .paper .sub{ margin-top:1.8em; font-size:1.12em; font-weight:400; display:flex; gap:.7em; align-items:center; padding-left:.6em; }
  .paper .sub .ico{ color:#c19a3b; flex:none; }
  .paper .warn{ color:var(--red); }
  .paper b{ font-weight:400; }

  footer{ padding:28px 24px; font-size:.85rem; color:var(--muted); max-width:1180px; margin:0 auto; }
  .skip-link{ position:absolute; top:-40px; left:8px; z-index:200; background:var(--ink); color:#fff; padding:8px 14px; font-size:.9rem; }
  .skip-link:focus{ top:46px; }
  @media (prefers-reduced-motion:reduce){ html{ scroll-behavior:auto; } *{ transition-duration:.001ms !important; animation:none !important; } }
</style>
</head>
<body>

<a class="skip-link" href="#main">Перейти до змісту</a>

<header>
  <nav class="nav">
    <a class="logo" href="index.html#hero"><img src="images/logo_09_09.png" alt="Назва бренду" class="logo-img"></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Відкрити меню">
      <img src="images/vty.png" alt="Меню">
    </button>
    <ul class="nav-links" id="nav-links">
      <li><a href="index.html#services"><img class="nav-folder" src="images/folder-zebra.png" alt=""><span class="nav-label">послуги</span></a></li>
      <li><a href="index.html#work"><img class="nav-folder" src="images/folder-grass.png" alt=""><span class="nav-label">роботи</span></a></li>
      <li><a href="index.html#contact"><img class="nav-folder" src="images/folder-leopard.png" alt=""><span class="nav-label">контакти</span></a></li>
      <li><a href="index.html#about"><img class="nav-folder" src="images/folder-pink.png" alt=""><span class="nav-label">про мене</span></a></li>
      <li><a href="faq.html"><img class="nav-folder nav-folder--faq" src="images/taksa-faq.png" alt=""><span class="nav-label">FAQ</span></a></li>
    </ul>
  </nav>
</header>

<main id="main">
  <div class="faq-photo">
    <span>фото</span>
    <!-- Поклади сюди своє фото: images/faq-photo.jpg -->
    <img src="images/faq-photo.jpg" alt="" onerror="this.style.display='none'">
  </div>

  <div class="faq-bg">
  <div class="faq">

    <section class="faq-item" aria-labelledby="q1">
      <h2 class="faq-q" id="q1">Що таке правки поза макетом? <span class="ico" aria-hidden="true">✎</span></h2>
      <div class="paper">
        <p class="lead"><span class="ico" aria-hidden="true">❦</span><span>Це правки, які виходять за межі того, що вже входить у ціну замовлення.</span></p>
        <p style="margin-top:1.2em">В ціну входять 2 раунди правок. Це і є «пакет».<br>Усе це вже оплачено.<br>Якщо клієнт просить ще, це вже правки поза пакетом, і їх оплачують окремо, погодинно (400–600 грн за годину).</p>
        <p>Приклад. Клієнт замовив візитку за 400 грн.</p>
        <ul>
          <li>Раунд 1: «змініть колір на синій». Входить у ціну.</li>
          <li>Раунд 2: «збільшіть логотип». Входить у ціну.</li>
          <li>Раунд 3: «а давайте все ж зелений, а шрифт інший». Це поза пакетом: дизайнер витратив пів години, тож клієнт доплачує.</li>
        </ul>

        <h3 class="sub"><span class="ico" aria-hidden="true">✣</span>Чому так роблять?</h3>
        <p style="margin-top:.8em">Без обмеження клієнт може вимагати змін безкінечно, і дизайнер за ті самі гроші працюватиме вдвічі-втричі більше.</p>
        <p class="warn">Це стосується одним раундом. Один раунд означає, що клієнт зібрав усі зауваження в один список, а не надсилає їх по одному. Дрібні виправлення на кшталт орфографічної помилки чи пропущеної цифри в телефоні зазвичай не рахують як раунд, якщо помилка на боці дизайнера.</p>
        <p>Що не є правкою: якщо клієнт повністю змінив ідею (робимо не візитку, а листівку) або надіслав нові вихідні матеріали, це нове замовлення, а не правка.</p>
      </div>
    </section>

    <!-- Щоб додати нове питання, скопіюй весь <section class="faq-item"> вище й зміни текст -->

  </div>
  </div>
</main>

<footer><div>© 2026</div></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.fog.min.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  VANTA.FOG({
    el:"body", mouseControls:true, touchControls:true, gyroControls:false,
    minHeight:200.00, minWidth:200.00,
    highlightColor:0xffffff, midtoneColor:0xc3beba, lowlightColor:0x91415e, baseColor:0xffffff,
    blurFactor:0.45, speed:0.5, zoom:1.28
  });
});
const toggle = document.querySelector('.nav-toggle');
const links = document.getElementById('nav-links');
if (toggle && links) {
  toggle.addEventListener('click', () => {
    const open = links.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open);
  });
  const closeMenu = () => { links.classList.remove('is-open'); toggle.setAttribute('aria-expanded','false'); };
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
}
</script>
</body>
</html>
